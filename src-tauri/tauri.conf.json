{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Br Ba Coding Agent",
  "version": "0.1.0",
  "identifier": "com.brbacoding.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Br Ba Coding Agent",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NDlGREUzOUI4QkNGRjMKUldUeno0dWI0LzFKMXM4SVdHUVZUeE8zWDFyQjBHV3ZLUkwzY0tadFJpaXdBbElJVHdlRlBoTFoK",
      "endpoints": [
        "https://github.com/Manixpcshot/BrBaCoding/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
